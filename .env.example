# ============================================================
# x402 Demo Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!
# ============================================================

# ------ SELLER (Resource Server) ------

# Your Algorand address that will receive payments (58 characters)
SELLER_ADDRESS=

# Price overrides — plain decimal USD. Defaults: 0.001 (weather), 0.005 (forecast)
SELLER_WEATHER_PRICE=0.001
SELLER_FORECAST_PRICE=0.005

# Optional: webhook URL called after each paid request (fire-and-forget POST)
WEBHOOK_URL=

# Optional: directory for payment log file (logs/payments.jsonl). Set to '' to disable.
LOG_DIR=./logs

# Rate limiting for paid endpoints (requests per minute per IP)
RATE_LIMIT_RPM=30
RATE_LIMIT_WINDOW_MS=60000

# Optional: Algorand node URL (defaults to testnet public node)
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# ------ BUYER (Client Agent) ------

# 25-word mnemonic seed phrase for the buying account
# This account needs ALGO for fees and USDC for payments
BUYER_MNEMONIC=

# ------ UI / WEB3AUTH ------

# Client ID from https://dashboard.web3auth.io (not a secret — safe to expose)
VITE_WEB3AUTH_CLIENT_ID=

# Seller URL the browser will call directly (must have CORS enabled)
VITE_SELLER_URL=

# Deployed UI origin — seller uses this to allow CORS from Vercel
UI_ORIGIN=

# ------ NETWORK ------

# Network to use: 'testnet' (default) or 'mainnet'
# Seller + buyer read NETWORK; UI reads VITE_NETWORK.
# For mainnet you also need:
#   - A funded mainnet SELLER_ADDRESS
#   - A Web3Auth project on Sapphire Mainnet (different client ID)
#   - Real USDC (ASA 31566704) in the buyer/wallet
NETWORK=testnet
VITE_NETWORK=testnet

# ------ SHARED ------

# Facilitator URL for payment verification and settlement
# Same URL handles both testnet and mainnet — routing is done by CAIP2 in the payload.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Seller API URL (where the buyer server will send requests)
# Use http://localhost:4021 for local testing
SELLER_URL=http://localhost:4021
