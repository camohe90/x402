# ============================================================
# x402 Demo Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!
# ============================================================

# ------ SELLER (Resource Server) ------

# Algorand address that will receive payments (58 characters)
SELLER_ADDRESS=

# Deployed UI origin — seller uses this to allow CORS (e.g. https://ui-vert-five.vercel.app)
UI_ORIGIN=

# Price overrides — plain decimal USD (e.g. "0.001"). Defaults shown.
SELLER_WEATHER_PRICE=0.001
SELLER_FORECAST_PRICE=0.005

# ------ BUYER (Client Agent) ------

# 25-word mnemonic for the buying account (needs ALGO for fees + USDC for payments)
BUYER_MNEMONIC=

# ------ UI (Vite / browser) ------

# Client ID from https://dashboard.web3auth.io
VITE_WEB3AUTH_CLIENT_ID=

# Public seller URL the browser calls directly — Railway URL or ngrok for local dev
VITE_SELLER_URL=

# ------ SHARED ------

# Facilitator for payment verification and settlement
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Seller URL for the buyer server (same as VITE_SELLER_URL when using Railway)
SELLER_URL=https://pleasant-unity-production-9aae.up.railway.app
