# ============================================================
# UI — Vite environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# Client ID from https://dashboard.web3auth.io
# Create a project on Sapphire Devnet — the Client ID is not a secret.
VITE_WEB3AUTH_CLIENT_ID=

# Public URL of your seller server that the browser calls directly.
# Use your Railway / Render / Fly URL in production.
# For local dev, expose with: npx ngrok http 4021
VITE_SELLER_URL=https://your-seller.up.railway.app
